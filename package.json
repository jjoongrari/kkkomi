{
  "name": "kvartirnik-komi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Квартирник Коми — угадай цену квартиры в Республике Коми",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/validate-data.mjs && next build --webpack && node scripts/security-headers.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:http",
    "test:http": "node tests/http-smoke.mjs",
    "import:csv": "node scripts/import-csv.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
